# --- Backend ---
#   local  : offline LSA embeddings (numpy only, no downloads) — DEFAULT
#   st     : sentence-transformers (downloads models from HuggingFace)
#   ollama : local Ollama server for embeddings + LLM
BACKEND=local

# --- local (offline LSA) ---
LSA_DIM=128

# --- st backend models (only used when BACKEND=st) ---
ST_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
NLI_MODEL=cross-encoder/nli-distilroberta-base
NLI_THRESHOLD=0.55

# --- Ollama backend (only used when BACKEND=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=orca-mini:latest
OLLAMA_EMBED_MODEL=nomic-embed-text
TEMPERATURE=0.2

# --- Paths ---
DOCUMENTS_PATH=./documents
VECTOR_STORE_PATH=./vector_store

# --- Chunking strategy ---
CHUNK_SIZE=700
CHUNK_OVERLAP=120

# --- Retrieval / reranking (tuning knobs) ---
TOP_K=4
POOL=20
RRF_K=60
RERANK=true
