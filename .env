# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=orca-mini:latest
OLLAMA_EMBED_MODEL=nomic-embed-text
TEMPERATURE=0.2

# --- Paths ---
DOCUMENTS_PATH=./documents
VECTOR_STORE_PATH=./vector_store

# --- Chunking strategy ---
CHUNK_SIZE=700
CHUNK_OVERLAP=120

# --- Retrieval / reranking (tuning knobs) ---
TOP_K=4
POOL=20
RRF_K=60
RERANK=true
